{
  "name": "sanctionskit",
  "version": "0.2.3",
  "description": "Official Node.js and TypeScript SDK for OFAC and sanctions screening, watchlist screening, restricted-party screening, batch screening, ongoing monitoring, and webhooks in AML, KYC and KYB workflows.",
  "license": "MIT",
  "author": "SanctionsKit <support@sanctionskit.com>",
  "homepage": "https://www.sanctionskit.com/integrations/typescript",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SanctionsKit/sanctionskit-node.git"
  },
  "bugs": {
    "url": "https://github.com/SanctionsKit/sanctionskit-node/issues"
  },
  "keywords": [
    "sanctionskit",
    "sanctions",
    "sanctions-screening",
    "screening",
    "watchlist",
    "watchlist-screening",
    "ofac",
    "ofac-sdn",
    "sdn",
    "compliance",
    "batch-screening",
    "javascript",
    "typescript",
    "nodejs",
    "api",
    "sdk",
    "uk-sanctions",
    "consolidated-screening-list",
    "bis",
    "denied-persons-list",
    "sanctions-api",
    "restricted-party-screening",
    "sanction",
    "sanction-screening",
    "sanctions-list",
    "sanctions-check",
    "sanctions-compliance",
    "ofac-screening",
    "ofac-api",
    "ofac-non-sdn",
    "restricted-party",
    "denied-party-screening",
    "export-control",
    "export-compliance",
    "aml",
    "aml-screening",
    "anti-money-laundering",
    "kyc",
    "kyb",
    "customer-due-diligence",
    "due-diligence",
    "customer-screening",
    "vendor-screening",
    "supplier-screening",
    "counterparty-screening",
    "entity-screening",
    "name-screening",
    "person-screening",
    "company-screening",
    "organization-screening",
    "vessel-screening",
    "aircraft-screening",
    "ongoing-monitoring",
    "sanctions-monitoring",
    "bulk-screening",
    "webhooks",
    "canada-sanctions",
    "swiss-sanctions",
    "seco",
    "japan-sanctions",
    "debarment",
    "exclusion-screening"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs && npm run test:types",
    "test:types": "tsc -p tests/tsconfig.json",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run build",
    "search:check": "node scripts/search-discovery.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "~5.9.3"
  }
}
