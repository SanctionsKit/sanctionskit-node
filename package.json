{
  "name": "sanctionskit",
  "version": "0.1.1",
  "description": "Official JavaScript and TypeScript SDK for sanctions screening, watchlist checks, and batch screening with the SanctionsKit API.",
  "license": "MIT",
  "author": "SanctionsKit <support@sanctionskit.com>",
  "homepage": "https://www.sanctionskit.com/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SanctionsKit/sanctionskit-node.git"
  },
  "bugs": {
    "url": "https://github.com/SanctionsKit/sanctionskit-node/issues"
  },
  "keywords": [
    "sanctionskit",
    "sanctions",
    "sanctions-screening",
    "screening",
    "watchlist",
    "watchlist-screening",
    "ofac",
    "ofac-sdn",
    "sdn",
    "compliance",
    "batch-screening",
    "javascript",
    "typescript",
    "nodejs",
    "api",
    "sdk"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {"types": "./dist/index.d.ts", "default": "./dist/index.js"},
      "require": {"types": "./dist/cjs/index.d.ts", "default": "./dist/cjs/index.js"}
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "engines": {"node": ">=22"},
  "publishConfig": {"access": "public"},
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs && npm run test:types",
    "test:types": "tsc -p tests/tsconfig.json",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run build"
  },
  "devDependencies": {"typescript": "~5.9.3"}
}
